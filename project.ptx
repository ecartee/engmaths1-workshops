<?xml version="1.0" encoding="utf-8"?>
<project ptx-version="2">
  <!-- Add one target per worksheet, in numeric order. -->
  <targets>
    <target name="worksheet1" format="html" source="worksheet1.ptx" deploy-dir="worksheet1">
      <stringparams html.css.extra="external/custom.css"/>
    </target>
  </targets>
</project>
