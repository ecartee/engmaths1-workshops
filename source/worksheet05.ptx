<!-- This renderer supplies English interface labels through en-US only.
     Keep authored worksheet prose in British English. -->
<!-- Workshop 5 comes after reading week. It covers all of Week 5 (functions
     and differentiation: stationary points, the rules, curve sketching,
     parametric and implicit differentiation), Week 7 video 1 (integration
     as a limit of sums) and the piecewise functions of Week 7 video 2.
     Substitution, probability densities and improper integrals (Week 7
     videos 2-3) are left for Workshop 6, with integration by parts and
     partial fractions. -->
<pretext xml:lang="en-US" xmlns:xi="http://www.w3.org/2001/XInclude">
  <xi:include href="docinfo.ptx"/>
  <article xml:id="worksheet05wks">
    <title>Engineering Maths 1</title>
    <introduction>
      <p>University of Bristol — EMAT10100</p>
      <p>Use the printer icon for a copy with working space. Give exact answers unless stated otherwise.</p>
    </introduction>
    <worksheet>
      <title>Workshop 5: Differentiation and integration</title>
      <page>
        <assemblage>
          <title>Warm-up</title>
          <p>Please work in collaboration with your classmates to complete the following exercises. This means sharing ideas and asking each other questions.</p>
        </assemblage>
        <!-- Part (v) needs f'(4), which the table does not give. -->
        <exercise xml:id="w5-table" workspace="1.0in">
          <statement>
            <p>Suppose that <m>f</m> and <m>g</m> are differentiable functions with these values.</p>
            <tabular halign="center" top="minor" left="minor" bottom="minor" right="minor">
              <col right="minor"/>
              <col right="minor"/>
              <col right="minor"/>
              <col right="minor"/>
              <col/>
              <row bottom="minor">
                <cell><m>x</m></cell><cell><m>f(x)</m></cell><cell><m>f'(x)</m></cell><cell><m>g(x)</m></cell><cell><m>g'(x)</m></cell>
              </row>
              <row><cell><m>1</m></cell><cell><m>3</m></cell><cell><m>-1</m></cell><cell><m>2</m></cell><cell><m>6</m></cell></row>
              <row><cell><m>2</m></cell><cell><m>1</m></cell><cell><m>4</m></cell><cell><m>3</m></cell><cell><m>-2</m></cell></row>
              <row><cell><m>3</m></cell><cell><m>2</m></cell><cell><m>5</m></cell><cell><m>4</m></cell><cell><m>7</m></cell></row>
            </tabular>
            <p>Differentiate each function at the given point, or explain why the table is not enough.
              <ol marker="(i)" cols="3">
                <li><m>f(x)\,g(x)</m> at <m>x=2</m></li>
                <li><m>f(x)/g(x)</m> at <m>x=1</m></li>
                <li><m>f(g(x))</m> at <m>x=1</m></li>
                <li><m>g(f(x))</m> at <m>x=1</m></li>
                <li><m>f(g(x))</m> at <m>x=3</m></li>
                <li><m>5f(x)</m> at <m>x=2</m></li>
              </ol>
            </p>
            <p>In (vi), use the product rule. Why does it agree with the constant multiple rule?</p>
          </statement>
        </exercise>
        <exercise xml:id="w5-truefalse" workspace="0.9in">
          <statement>
            <p>Share out these statements with your neighbours. Decide whether each is true or false, then compare. Explain in your own words why the false ones are false.</p>
            <tabular halign="center" top="minor" left="minor" bottom="minor" right="minor">
              <col width="70%" right="minor" halign="left"/>
              <col width="12%" right="minor"/>
              <col width="12%"/>
              <row bottom="minor">
                <cell>Statement</cell><cell>True</cell><cell>False</cell>
              </row>
              <row bottom="minor"><cell><m>\rule[-0.4em]{0pt}{1.3em}f(x)=x^{1/3}</m> has a derivative at <m>x=0</m>.</cell><cell></cell><cell></cell></row>
              <row bottom="minor"><cell><m>\rule[-0.4em]{0pt}{1.3em}</m>The graph of <m>y=x^{1/3}</m> has a tangent line at <m>(0,0)</m>.</cell><cell></cell><cell></cell></row>
              <row bottom="minor"><cell><m>\rule[-0.4em]{0pt}{1.3em}f(x)=|x|</m> has a derivative at <m>x=0</m>.</cell><cell></cell><cell></cell></row>
              <row bottom="minor"><cell><m>\rule[-0.4em]{0pt}{1.3em}g(x)=x|x|</m> has a derivative at <m>x=0</m>.</cell><cell></cell><cell></cell></row>
              <row bottom="minor"><cell><m>\rule[-0.4em]{0pt}{1.3em}</m>If <m>f</m> is even and differentiable, then <m>f'</m> is odd.</cell><cell></cell><cell></cell></row>
              <row bottom="minor"><cell><m>\rule[-0.4em]{0pt}{1.3em}</m>If <m>f'(a)=0</m> and <m>f''(a)=0</m>, then <m>f</m> has a point of inflection at <m>x=a</m>.</cell><cell></cell><cell></cell></row>
              <row><cell><m>\rule[-0.4em]{0pt}{1.3em}</m>If <m>y=\sin^{-1}x</m>, then <m>\dd y/\dd x=-(\sin x)^{-2}\cos x</m>.</cell><cell></cell><cell></cell></row>
            </tabular>
          </statement>
        </exercise>
      </page>
      <page>
        <assemblage>
          <title>Practice: Curve Sketching</title>
        </assemblage>
        <exercise xml:id="w5-sketch">
          <introduction>
            <p>Let <m>f(x)=\dfrac{4(x-1)}{x^2}</m>.</p>
          </introduction>
          <task workspace="1.6in">
            <statement><p>Find where the graph of <m>f</m> crosses the <m>x</m>-axis, and find its asymptotes. How does <m>f</m> behave on each side of its vertical asymptote?</p></statement>
          </task>
          <task workspace="1.8in">
            <statement><p>Find <m>f'(x)</m>. Then find the stationary point of <m>f</m> and classify it.</p></statement>
          </task>
          <task workspace="2.4in">
            <statement><p>Sketch the graph of <m>f</m>.</p></statement>
          </task>
        </exercise>
      </page>
      <page>
        <assemblage>
          <title>Practice: Parametric Curves</title>
        </assemblage>
        <exercise xml:id="w5-lissajous">
          <introduction>
            <p>An oscilloscope in XY mode plots one signal against another. Suppose that it plots the signal <m>y=\sin 2t</m> against the signal <m>x=\sin t</m>, for <m>0\le t\le 2\pi</m>. The curve that the point <m>(x,y)</m> traces is called a Lissajous figure.</p>
          </introduction>
          <task workspace="2.0in">
            <statement><p>Find <m>\dfrac{\dd y}{\dd x}</m> in terms of <m>t</m>. At which points <m>(x,y)</m> is the tangent to the curve horizontal? At which is it vertical?</p></statement>
          </task>
          <task workspace="1.0in">
            <statement><p>The curve passes through the origin twice. Find the slope of the tangent each time.</p></statement>
          </task>
          <task workspace="2.1in">
            <statement><p>Sketch the curve.</p></statement>
          </task>
        </exercise>
      </page>
      <page>
        <assemblage>
          <title>Practice: Implicit Differentiation</title>
        </assemblage>
        <exercise xml:id="w5-implicit">
          <introduction>
            <p>The curve in Exercise 4 can also be described without the parameter <m>t</m>.</p>
          </introduction>
          <task workspace="1.4in">
            <statement><p>Show that every point on the curve satisfies <m>y^2=4x^2(1-x^2)</m>.</p></statement>
          </task>
          <task workspace="2.2in">
            <statement><p>Use implicit differentiation to find <m>\dfrac{\dd y}{\dd x}</m> in terms of <m>x</m> and <m>y</m>. If you have time, check that your answer agrees with Exercise 4(a) at the point <m>\left(\tfrac{\sqrt{3}}{2},\tfrac{\sqrt{3}}{2}\right)</m>.</p></statement>
          </task>
          <task workspace="1.8in">
            <statement><p>What happens when you put the origin into your answer to part (b)? Explain in your own words how this fits with Exercise 4(b).</p></statement>
          </task>
        </exercise>
      </page>
      <page>
        <assemblage>
          <title>Practice: Cutting a Pie</title>
        </assemblage>
        <exercise xml:id="w5-pie">
          <introduction>
            <p>Suppose that three groups each estimate the area of a circular pie of radius <m>R</m> by cutting it into <m>n</m> thin pieces.
              <ul>
                <li>Group A cuts <m>n</m> equal sectors, the usual way to cut a pie.</li>
                <li>Group B cuts <m>n</m> rings of equal width around the centre.</li>
                <li>Group C makes parallel straight cuts, giving <m>n</m> strips of equal width.</li>
              </ul>
            </p>
          </introduction>
          <task workspace="2.2in">
            <statement><p>Sketch each group's pieces. For each group, approximate the area of one piece by a triangle or a rectangle, and write the group's estimate as a sum.</p></statement>
          </task>
          <task workspace="1.2in">
            <statement><p>Write down the integral that each sum tends to as <m>n\to\infty</m>. Do not evaluate them.</p></statement>
          </task>
          <task workspace="1.4in">
            <statement><p>Explain in your own words the advantages and disadvantages of each group's method. Which methods would still work for a pie that is not circular?</p></statement>
          </task>
        </exercise>
      </page>
      <page>
        <assemblage>
          <title>Challenge: Moving a Part</title>
        </assemblage>
        <exercise xml:id="w5-motion">
          <introduction>
            <p>Suppose that a machine slides a part along a straight track, with its position <m>x</m> in metres and the time <m>t</m> in seconds. At <m>t=0</m> the part is at rest at <m>x=0</m>. It speeds up with acceleration <m>1</m> for one second, then slows down with acceleration <m>-1</m> for one second, and after that its acceleration is zero.</p>
          </introduction>
          <task workspace="2.2in">
            <statement><p>Write down the acceleration <m>a(t)</m> for <m>t\ge 0</m>. Integrate it to find the velocity <m>v(t)</m>, and sketch the graphs of <m>a</m> and <m>v</m>.</p></statement>
          </task>
          <task workspace="1.7in">
            <statement><p>Find the position <m>x(t)</m> for <m>t\ge 0</m>. How far does the part move?</p></statement>
          </task>
          <task workspace="1.4in">
            <statement><p>Which of <m>a</m>, <m>v</m> and <m>x</m> are continuous at <m>t=1</m> and <m>t=2</m>? Which are differentiable there? Explain in your own words how integrating changes a function.</p></statement>
          </task>
        </exercise>
      </page>
    </worksheet>
  </article>
</pretext>
