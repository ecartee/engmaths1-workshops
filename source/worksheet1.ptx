<?xml version="1.0" encoding="utf-8"?>
<!-- This renderer supplies English interface labels through en-US only.
     Keep authored worksheet prose in British English. -->
<pretext xml:lang="en-US">
  <article xml:id="worksheet1wks">
    <title>Engineering Maths 1</title>
    <introduction>
      <p>University of Bristol — EMAT10100</p>
      <p>Use the printer icon for a copy with working space. Give exact answers unless stated otherwise.</p>
    </introduction>
    <worksheet>
      <title>Workshop 1: Algebra and vectors</title>
      <page>
        <assemblage>
          <title>Warm-up</title>
          <p>Compare your answers with a neighbour.</p>
        </assemblage>
        <exercise xml:id="w1-quadratic">
          <introduction><p>A few Week 1 skills:</p></introduction>
          <task workspace="0.7in">
            <statement><p>Complete the square in <m>2x^2-10x+7</m> and find its minimum value.</p></statement>
          </task>
          <task workspace="0.6in">
            <statement><p>For <m>x,y&gt;0</m>, express <m>\ln(x^3/\sqrt{y})</m> in terms of <m>\ln x</m> and <m>\ln y</m>.</p></statement>
          </task>
          <task workspace="0.8in">
            <statement><p>Differentiate <m>(4x-1)e^{2x}</m>.</p></statement>
          </task>
        </exercise>
        <exercise xml:id="w1-displacement" workspace="1.5in">
          <statement>
            <p>Let <m>A=(-4,2,5)</m> and <m>B=(2,-1,7)</m>. Two proposed unit vectors from <m>A</m> towards <m>B</m> are</p>
            <me>\vec{u}=\frac{1}{7}(6,-3,2),\qquad \vec{v}=\frac{1}{49}(6,-3,2).</me>
            <p>Which is correct? Justify your choice and explain why the other is incorrect.</p>
          </statement>
        </exercise>
      </page>
      <page>
        <assemblage>
          <title>Practice</title>
          <p>Combine forces using vector addition.</p>
        </assemblage>
        <exercise xml:id="w1-forces">
          <introduction>
            <p>Two forces act on a bracket: <m>\vec{F}_1=(6,-8,0)</m> N, and <m>\vec{F}_2</m> has magnitude <m>15</m> N in the direction <m>\vec{v}=(-2,1,2)</m>.</p>
          </introduction>
          <task workspace="1in">
            <statement><p>Find the components of <m>\vec{F}_2</m> and the sum <m>\vec{R}=\vec{F}_1+\vec{F}_2</m>.</p></statement>
          </task>
          <task workspace="1.2in">
            <statement><p>Find the magnitude of <m>\vec{R}</m> and a unit vector in its direction.</p></statement>
          </task>
          <task workspace="1.1in">
            <statement><p>Find the angle between the forces, to the nearest degree.</p></statement>
          </task>
          <task workspace="0.8in">
            <statement><p>Why is <m>|\vec{R}|&lt;|\vec{F}_1|+|\vec{F}_2|</m>?</p></statement>
          </task>
        </exercise>
      </page>
      <page>
        <assemblage>
          <title>Practice (continued)</title>
          <p>Include units in your answers.</p>
        </assemblage>
        <exercise xml:id="w1-work">
          <introduction>
            <p>A force <m>\vec{F}=(8,-6,5)</m> N moves a slider through displacement <m>\vec{d}=(2,-2,1)</m> m.</p>
          </introduction>
          <task workspace="1.1in">
            <statement><p>Find the scalar component and vector projection of <m>\vec{F}</m> along <m>\vec{d}</m>.</p></statement>
          </task>
          <task workspace="1.2in">
            <statement><p>Find <m>\vec{F}_\perp=\vec{F}-\vec{F}_\parallel</m>, where <m>\vec{F}_\parallel</m> is your projection. Check that <m>\vec{F}_\perp\cdot\vec{d}=0</m>.</p></statement>
          </task>
          <task workspace="1.4in">
            <statement><p>Calculate the work <m>W=\vec{F}\cdot\vec{d}</m>. Check it using part (a). Why does <m>\vec{F}_\perp</m> do no work?</p></statement>
          </task>
        </exercise>
      </page>
      <page>
        <assemblage>
          <title>Challenge: algebra meets geometry</title>
          <p>Connect the sign of a dot product with the angle between two vectors.</p>
        </assemblage>
        <exercise xml:id="w1-parameter">
          <introduction>
            <p>For real <m>x</m>, let <m>\vec{a}=(x,2,3)</m> and <m>\vec{b}=(2x-5,x,-1)</m>.</p>
          </introduction>
          <task workspace="1.4in">
            <statement><p>Find all values of <m>x</m> for which <m>\vec{a}</m> and <m>\vec{b}</m> are perpendicular.</p></statement>
          </task>
          <task workspace="1.8in">
            <statement><p>For which values of <m>x</m> is the angle acute? For which is it obtuse?</p></statement>
          </task>
          <task workspace="1in">
            <statement><p>Why are both vectors nonzero for every <m>x</m>? Why does this matter?</p></statement>
          </task>
        </exercise>
      </page>
    </worksheet>
  </article>
</pretext>
